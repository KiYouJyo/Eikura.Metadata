<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <VersionPrefix>0.2.23</VersionPrefix>
    <!-- Keep the managed ABI stable across compatible 0.1.x runtime updates. -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.2.23.0</FileVersion>
    <InformationalVersion>0.2.23</InformationalVersion>
    <Authors>KiYouJyo</Authors>
    <RepositoryUrl>https://github.com/KiYouJyo/Eizo.Metadata</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/KiYouJyo/Eizo.Metadata</PackageProjectUrl>
    <PackageTags>eizo;metadata;recognition;media;anime;drama</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>
</Project>
